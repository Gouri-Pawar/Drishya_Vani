<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#FFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Emoji Icon (was ImageView, now TextView to show emoji) -->
        <!-- FIX: Changed ImageView → TextView with id txtPlaceEmoji to match adapter -->
        <TextView
            android:id="@+id/txtPlaceEmoji"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:gravity="center"
            android:textSize="28sp"
            android:background="@drawable/bg_thumb_rounded"
            android:layout_centerVertical="true"
            android:text="📍" />

        <!-- ❤️ Heart Button (remove from favourites) -->
        <!-- FIX: id changed from imgHeart → imgFav to match adapter's imgRemove binding -->
        <ImageView
            android:id="@+id/imgFav"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_heart_filled"
            android:padding="5dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Remove from Favourites"
            app:tint="#FF5A5F"/>

        <!-- Text Block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/txtPlaceEmoji"
            android:layout_toStartOf="@id/imgFav"
            android:layout_centerVertical="true"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <!-- Place Name -->
            <TextView
                android:id="@+id/txtPlaceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Place Name"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- FIX: Added txtPlaceType TextView (was missing, adapter calls holder.placeType.setText()) -->
            <TextView
                android:id="@+id/txtPlaceType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#AB84ED"
                android:layout_marginTop="3dp" />

            <!-- Distance row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_place_default"
                    app:tint="#AB84ED"/>

                <!-- FIX: id changed from txtFavStatus → txtDistance to match adapter -->
                <TextView
                    android:id="@+id/txtDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distance unavailable"
                    android:textSize="12sp"
                    android:textColor="#7C7C9A"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>