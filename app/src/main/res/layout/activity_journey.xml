<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/light_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- Location Status -->
        <TextView
            android:id="@+id/txtLocationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detecting location..."
            android:textColor="#022081"
            android:textSize="13sp"
            android:letterSpacing="0.04"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="20dp"/>

        <!-- Image Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="230dp"
            card_view:cardCornerRadius="24dp"
            card_view:cardElevation="16dp"
            card_view:cardBackgroundColor="#1A1560"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/imgLandmark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/img"/>

        </androidx.cardview.widget.CardView>

        <!-- Landmark Info Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardCornerRadius="24dp"
            card_view:cardElevation="10dp"
            card_view:cardBackgroundColor="#163FA6"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- Landmark Name -->
                <TextView
                    android:id="@+id/txtLandmarkName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Landmark Name"
                    android:textColor="#E8DCFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    android:layout_marginBottom="12dp"/>

                <!-- Landmark Description -->
                <TextView
                    android:id="@+id/txtDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Landmark description will appear here."
                    android:textColor="#9AABCC"
                    android:textSize="15sp"
                    android:lineSpacingExtra="6dp"
                    android:letterSpacing="0.02"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Play Story Button -->
        <Button
            android:id="@+id/btnPlayStory"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Play Audio Story"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:backgroundTint="#422EBC"
            android:elevation="10dp"
            android:stateListAnimator="@null"/>

    </LinearLayout>

</ScrollView>