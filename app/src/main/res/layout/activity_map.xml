<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/light_gradient"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/txtMapTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Location"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#0D3B66"
        android:letterSpacing="0.03"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="48dp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/txtMapSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Find and share where you are"
        android:textSize="13sp"
        android:textColor="#5B8DB8"
        android:layout_below="@id/txtMapTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp" />

    <!-- Map Icon inside a white pill card -->
    <LinearLayout
        android:id="@+id/iconCard"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_below="@id/txtMapSubtitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_icon_card"
        android:gravity="center"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/imgMapIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_map_location"
            android:contentDescription="Map Icon" />
    </LinearLayout>

    <!-- Access Location Button -->
    <Button
        android:id="@+id/btnAccessLocation"
        android:layout_width="220dp"
        android:layout_height="52dp"
        android:text="Access Your Location"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:layout_below="@id/iconCard"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:backgroundTint="#0D3B66"
        android:elevation="4dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp" />

    <!-- Map Placeholder with rounded corners -->
    <ImageView
        android:id="@+id/imgMapPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="370dp"
        android:layout_below="@id/btnAccessLocation"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_map_card"
        android:scaleType="centerCrop"
        android:src="@drawable/img_1"
        android:contentDescription="Map Placeholder"
        android:elevation="4dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Info Text -->
    <TextView
        android:id="@+id/txtMapInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your current location will display here."
        android:textSize="13sp"
        android:textColor="#7BAFD4"
        android:layout_below="@id/imgMapPlaceholder"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="14dp" />

</RelativeLayout>